# Anchored to the repo root with a leading slash. A BARE pattern like `data`
# matches EVERY path segment of that name at any depth -- inheriting one from the
# prior repo silently excluded the bgcbench/data/ source package. Keep the slashes.
/data
/data/
/tmp/
/checkpoints/
/figures/
/out/

.claude/
__pycache__/
*.py[cod]
.venv/
